# Copy to .env and adjust. All are optional — the defaults run fine locally.

# Guards POST /api/admin/refresh. Leave empty to disable that endpoint entirely
# (the CLI and the `ingest` compose profile still work).
ATLAS_ADMIN_TOKEN=

# Ports on the host.
ATLAS_WEB_PORT=5173
ATLAS_API_PORT=8000

# Pull upstream automatically when the database has no models yet.
ATLAS_INGEST_ON_EMPTY=true

# Comma-separated browser origins allowed to call the API directly.
# Not needed when the frontend is served by nginx (same origin).
ATLAS_CORS_ORIGINS=http://localhost:5173
